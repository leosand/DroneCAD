<?xml version="1.0" ?>
<!-- DroneCAD — monde avec obstacles / world with obstacles (Gazebo Harmonic).
     EN: flat ground + a step, two low walls and a pillar for navigation/avoidance phases.
     FR : sol plat + une marche, deux murets bas et un pilier pour les phases navigation/évitement. -->
<sdf version="1.10">
  <world name="obstacles">
    <physics name="default_physics" default="true" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_step">
      <static>true</static>
      <pose>0.9 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.08</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.08</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall_a">
      <static>true</static>
      <pose>1.8 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 1.2 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.2 0.5</size></box></geometry>
          <material><ambient>0.4 0.45 0.55 1</ambient><diffuse>0.4 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall_b">
      <static>true</static>
      <pose>1.8 -0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 1.2 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 1.2 0.5</size></box></geometry>
          <material><ambient>0.4 0.45 0.55 1</ambient><diffuse>0.4 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_pillar">
      <static>true</static>
      <pose>2.6 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.45 0.35 0.5 1</ambient><diffuse>0.45 0.35 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
