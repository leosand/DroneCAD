{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": ["mcp-for-blender"]
    },
    "freecad": {
      "command": "uvx",
      "args": ["--from", "freecad-robust-mcp", "--with", "mcp<2", "freecad-mcp"],
      "env": { "FREECAD_MODE": "xmlrpc" }
    },
    "ros2": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "dronecad-ros2-jazzy",
        "bash",
        "-lc",
        "source /opt/ros/jazzy/setup.bash && exec /opt/ros2-mcp/.venv/bin/mcp_ros_2_server"
      ]
    },
    "rosbags": {
      "command": "uv",
      "args": [
        "run",
        "--with-requirements",
        "${DRONECAD_HOME}/vendor/mcp-rosbags/requirements.txt",
        "--with",
        "rosbags<0.10",
        "${DRONECAD_HOME}/vendor/mcp-rosbags/src/server.py"
      ]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@shodh/memory-mcp"]
    }
  }
}
